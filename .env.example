# ScoutBase Africa - Environment Variables
# =========================================
# Copy this file to .env and fill in your values

# ---------------------------------------------------------------------------
# SAM3 Configuration (Required for SAM3 features)
# ---------------------------------------------------------------------------

# HuggingFace API token (required for SAM3 model access)
# 1. Create account at https://huggingface.co
# 2. Request access to SAM2 models at https://huggingface.co/facebook/sam2.1-hiera-base-plus
# 3. Generate token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SAM3 model variant: "base", "large", or "huge"
# - base: ~375MB, fastest, good for most use cases
# - large: ~750MB, better accuracy
# - huge: ~2.5GB, best accuracy (requires more VRAM)
SAM3_VARIANT=base

# Compute device: "cuda", "cpu", or "auto"
# - auto: Uses CUDA if available, falls back to CPU
SAM3_DEVICE=auto

# Lazy load model on first request (recommended for memory efficiency)
SAM3_LAZY_LOAD=true

# SAM3 Backend: "local" (CPU/GPU) or "modal" (serverless GPU)
# SAM3_BACKEND=local
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------

# PostgreSQL (production — set this to use asyncpg instead of SQLite)
# DATABASE_URL=postgresql://postgres:password@host:5432/dbname

# Supabase Configuration (managed PostgreSQL + Auth + Storage)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_DB_PASSWORD=
# SUPABASE_JWT_SECRET=  # For JWT auth validation on API endpoints

# ---------------------------------------------------------------------------
# AI Report Generation (Optional)
# ---------------------------------------------------------------------------

# Google Gemini API key for scout reports
# GEMINI_API_KEY=AIza...

# Anthropic API key (alternative to Gemini)
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Server Configuration
# ---------------------------------------------------------------------------

# API port (default: 8000)
# PORT=8000

# Enable debug mode
# DEBUG=false

# CORS allowed origins (comma-separated, for frontend dev servers)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Maximum video upload file size in MB (default: 2048 = 2GB)
# MAX_UPLOAD_SIZE_MB=2048
